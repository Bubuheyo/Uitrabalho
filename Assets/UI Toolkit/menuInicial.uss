:root {
}

.Menu_Botoes {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgba(149, 149, 149, 0);
    border-right-color: rgba(149, 149, 149, 0);
    border-top-color: rgba(149, 149, 149, 0);
    border-bottom-color: rgba(149, 149, 149, 0);
    position: relative;
    top: auto;
    left: 13%;
    -unity-font-definition: url("project://database/Assets/gabriola-font.ttf?fileID=12800000&guid=55c6abe187c4c4e449f8eb5852f4d261&type=3#gabriola-font");
    font-size: 20px;
    rotate: 1deg;
    width: auto;
    height: 0%;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    right: auto;
    min-height: auto;
    padding-top: 6px;
    bottom: -43px;
}

.Menu_Botoes:hover {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    background-color: rgba(188, 188, 188, 0);
    border-left-color: rgb(149, 149, 149);
    border-right-color: rgb(149, 149, 149);
    border-top-color: rgb(149, 149, 149);
    border-bottom-color: rgb(149, 149, 149);
    position: relative;
    top: auto;
    left: auto;
    -unity-font-definition: url("project://database/Assets/gabriola-font.ttf?fileID=12800000&guid=55c6abe187c4c4e449f8eb5852f4d261&type=3#gabriola-font");
    font-size: 20px;
    rotate: 0;
    width: auto;
    height: 8%;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    transition-duration: 2s;
    transition-delay: 1s;
}
